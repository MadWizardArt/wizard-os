generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectType {
  ARTWORK
  COMMISSION
  DIGITAL_PRODUCT
  CONTENT
  INTERNAL
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  WAITING
  BLOCKED
  COMPLETE
  ARCHIVED
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETE
  SKIPPED
}

enum TransactionType {
  INCOME
  EXPENSE
  REFUND
}

enum IncomeClass {
  ACTIVE
  RECURRING
  PASSIVE_LIKE
}

enum VentureStatus {
  IDEA
  VALIDATING
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CustomerType {
  COLLECTOR
  CLIENT
  LEAD
  PARTNER
  OTHER
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Project {
  id           String        @id @default(cuid())
  title        String
  type         ProjectType
  status       ProjectStatus @default(PLANNED)
  progress     Int           @default(0)
  valueCents   Int?
  dueDate      DateTime?
  nextAction   String?
  notes        String?
  templateId   String?
  customerId   String?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  artwork      Painting?
  campaigns    Campaign[]
  template     WorkflowTemplate? @relation(fields: [templateId], references: [id])
  stages       ProjectStage[]
  transactions Transaction[]
  customer     Customer?         @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([dueDate])
}

model MuseumProposal {
  id        String   @id @default(cuid())
  payload   String
  sourceKey String   @unique
  museId    String
  category  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([museId, status])
  @@index([category])
}

model MuseumIntelligenceQuest {
  id        String   @id @default(cuid())
  payload   String
  museId    String
  category  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([museId, category])
}

model WorkflowTemplate {
  id          String      @id @default(cuid())
  name        String
  projectType ProjectType
  version     Int         @default(1)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  stages   WorkflowTemplateStage[]
  projects Project[]
}

model WorkflowTemplateStage {
  id                String @id @default(cuid())
  templateId        String
  name              String
  position          Int
  defaultFieldsJson String @default("{}")

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
}

model ProjectStage {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  position    Int
  status      StageStatus @default(NOT_STARTED)
  progress    Int         @default(0)
  fieldsJson  String      @default("{}")
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amountCents Int
  occurredAt  DateTime
  receivedAt  DateTime?
  source      String
  incomeClass IncomeClass?
  isNonArt    Boolean         @default(false)
  notes       String?
  projectId   String?
  ventureId   String?
  customerId  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  isArtworkReceipt Boolean @default(false)
  salesTaxCents Int @default(0)
  shippingCents Int @default(0)
  receiptKey String? @unique
  artworkSaleId String?
  artworkSale ArtworkSale? @relation(fields: [artworkSaleId], references: [id])

  project Project? @relation(fields: [projectId], references: [id])
  venture Venture? @relation(fields: [ventureId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([receivedAt])
  @@index([type, incomeClass, isNonArt])
}

model Customer {
  id            String         @id @default(cuid())
  name          String
  email         String?
  phone         String?
  type          CustomerType   @default(LEAD)
  status        CustomerStatus @default(LEAD)
  notes         String?
  lastContactAt DateTime?
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  projects     Project[]
  transactions Transaction[]

  @@index([status])
  @@index([lastContactAt])
}

model Venture {
  id            String        @id @default(cuid())
  name          String
  description   String?
  status        VentureStatus @default(IDEA)
  demand        Int           @default(3)
  margin        Int           @default(3)
  recurrence    Int           @default(3)
  automation    Int           @default(3)
  defensibility Int           @default(3)
  startupCost   Int           @default(3)
  weeklyHours   Int           @default(3)
  nextAction    String?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions Transaction[]

  @@index([status])
}

model Campaign {
  sales ArtworkSale[]
  id String @id @default(cuid())
  title String
  status String @default("Draft")
  startDate String
  endDate String
  targetCents Int @default(0)
  notes String @default("")
  projectId String?
  project Project? @relation(fields: [projectId], references: [id])
  tasks CampaignTask[]
  artwork CampaignPainting[]
  content CampaignContent[]
  batches ProductionBatch[]
  transactions Transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignTask {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title String
  dueDate String
  dueTime String?
  category String @default("Preparation")
  completed Boolean @default(false)
}

model Painting {
  materialsCostCents Int?
  framingCostCents Int?
  sales ArtworkSale[]
  history ArtworkHistory[]
  projectId String @id
  project Project @relation(fields: [projectId], references: [id])
  thumbnail String @default("")
  dimensions String @default("")
  medium String @default("")
  framing String @default("")
  availability String @default("Available")
  regularPriceCents Int?
  campaigns CampaignPainting[]
  batchId String?
  batch ProductionBatch? @relation(fields: [batchId], references: [id])
}

model CampaignPainting {
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  projectId String
  painting Painting @relation(fields: [projectId], references: [projectId])
  salePriceCents Int?
  @@id([campaignId, projectId])
}

model CampaignContent {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title String
  text String @default("")
  postingDate String
  status String @default("Draft")
}

model ProductionBatch {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title String
  plannedQuantity Int
  unitPriceCents Int
  weeklyQuantity Int
  startDate String
  completionDate String
  paintings Painting[]
}

model SalesGoal {
  id String @id
  targetCents Int
  startDate String
  dueDate String
  basis String @default("Gross artwork receipts")
  excludeSalesTax Boolean @default(true)
  excludeShipping Boolean @default(true)
}

model ArtworkSale {
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  id String @id @default(cuid())
  projectId String
  painting Painting @relation(fields: [projectId], references: [projectId])
  saleDate String
  salePriceCents Int
  discountCents Int @default(0)
  salesTaxCents Int @default(0)
  shippingIncomeCents Int @default(0)
  sellingFeesCents Int?
  shippingExpenseCents Int?
  fulfillment String @default("Awaiting shipment")
  status String @default("Active")
  notes String @default("")
  requestKey String @unique
  transactions Transaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ArtworkHistory {
  id String @id @default(cuid())
  projectId String
  painting Painting @relation(fields: [projectId], references: [projectId])
  fromStatus String?
  toStatus String
  note String
  createdAt DateTime @default(now())
}

model GrottoImage {
  id                 String   @id @default(cuid())
  museId             String
  contentType        String
  imageData          Bytes?
  blobUrl            String?  @unique
  byteSize           Int
  provider           String   @default("manual")
  providerWorkflowId String?
  providerImageId    String?  @unique
  prompt             String   @default("")
  recipeJson         String   @default("{}")
  favorite           Boolean  @default(false)
  canonical          Boolean  @default(false)
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  galleryAddedAt     DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([museId, deletedAt, createdAt])
  @@index([museId, deletedAt, galleryAddedAt])
  @@index([museId, favorite])
  @@index([providerWorkflowId])
}

// One encrypted, private Etsy OAuth grant shared by the owner and authorized Warlock API clients.
model EtsyConnection {
  id               String   @id
  encryptedSession String
  updatedAt        DateTime @updatedAt
}


enum SpellmarkFulfillment {
  DIGITAL
  PHYSICAL
}

// Spellmark identity is owned here, not by Etsy listings or Printful sync products.
model SpellmarkProduct {
  id               String             @id @default(cuid())
  title            String
  collection       String             @default("")
  description      String             @default("")
  artworkReference String             @default("")
  status           String             @default("DESIGN")
  notes            String             @default("")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  variants         SpellmarkVariant[]
  assets           SpellmarkAsset[]
  listings         SpellmarkListing[]

  @@index([collection, status])
}

model SpellmarkAsset {
  id          String           @id @default(cuid())
  productId   String
  product     SpellmarkProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  role        String           @default("other")
  fileName    String
  blobUrl     String           @unique
  pathname    String
  contentType String
  byteSize    Int
  createdAt   DateTime         @default(now())
  listingLinks SpellmarkListingAsset[]

  @@index([productId, role])
}

model SpellmarkVariant {
  id                  String               @id @default(cuid())
  productId           String
  product             SpellmarkProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  fulfillment         SpellmarkFulfillment
  label               String
  printfulProductId   Int?
  printfulVariantId   Int?
  printfulStoreId     Int?
  etsyListingId       String?
  etsySku             String?
  etsyProductId       String?
  printfulSyncVariantId Int?
  retailPriceCents    Int?
  productionBaseCents Int?
  productionQuotedAt  DateTime?
  currency            String               @default("USD")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([productId, fulfillment])
  @@index([printfulVariantId])
  @@index([etsyListingId])
  @@index([etsyProductId])
  @@index([printfulSyncVariantId])
}


model SpellmarkListing {
  id               String               @id @default(cuid())
  productId        String
  product          SpellmarkProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  fulfillment      SpellmarkFulfillment
  title            String
  description      String               @default("")
  tagsJson         String               @default("[]")
  taxonomyId       Int?
  shippingProfileId String?
  readinessStateId String?
  quantity         Int                  @default(999)
  whoMade          String               @default("i_did")
  whenMade         String               @default("2020_2026")
  isSupply         Boolean              @default(false)
  shouldAutoRenew  Boolean              @default(true)
  etsyListingId    String?
  printfulSyncProductId Int?
  lastDraftSyncAt  DateTime?
  status           String               @default("CONFIG")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assets           SpellmarkListingAsset[]

  @@unique([productId, fulfillment])
  @@index([etsyListingId])
  @@index([printfulSyncProductId])
  @@index([status])
}

model SpellmarkListingAsset {
  id        String           @id @default(cuid())
  listingId String
  listing   SpellmarkListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  assetId   String
  asset     SpellmarkAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind      String           @default("image")
  position  Int              @default(1)
  etsyRemoteId String?
  etsySyncedAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([listingId, assetId])
  @@unique([listingId, kind, position])
  @@index([assetId])
}
