# Runtime: use the pooled Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Prisma CLI/migrations: use the direct Neon connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Canonical Vercel project: wizard-os-299p
# Legacy project wizard-os is retired and should not be reconnected to Git.

# Etsy / Warlock (values live in Vercel; never commit real secrets)
ETSY_API_KEYSTRING=""
ETSY_REDIRECT_URI="https://wizard-os-299p-jade.vercel.app/api/etsy/callback"
ETSY_SHARED_SECRET=""
ETSY_SESSION_SECRET=""
MUSE_HANDOFF_SECRET=""
# Private Warlock operator credential used by direct API clients and the staged MCP.
# Use a random value of at least 32 characters.
WARLOCK_API_KEY=""
# Etsy shop allowlist required before the operator grant can be persisted.
WARLOCK_SHOP_ID=""
# Keep false until the remote MCP endpoint is intentionally enabled.
WARLOCK_MCP_ENABLED="false"

# Museum Artist Gate and trusted Project knowledge intake.
MUSE_ARTIST_ACCESS_KEY=""
# Optional dedicated session-signing secret. When omitted, Artist access key is used.
MUSE_ARTIST_SESSION_SECRET=""
MUSE_KNOWLEDGE_INGEST_KEY=""

# Selective Intelligence. Fuel remains off until explicitly enabled.
MUSE_INTELLIGENCE_ENABLED="false"
MUSE_INTELLIGENCE_MODEL="openai/gpt-5.6-sol"
MUSE_INTELLIGENCE_MAX_RUNS_PER_DAY="4"
MUSE_INTELLIGENCE_DAILY_TOKEN_BUDGET="15000"
MUSE_INTELLIGENCE_MAX_OUTPUT_TOKENS="1000"

# Optional explicit AI Gateway credential for local/non-OIDC environments.
# Production normally resolves a request-scoped Vercel OIDC token instead.
AI_GATEWAY_API_KEY=""

# The Grotto. Generation is private and gated behind the Museum Artist Gate.
# Preview smoke tests require the same private Grotto generation variables as Production.
GROTTO_GENERATION_ENABLED="false"
CIVITAI_ORCHESTRATION_TOKEN=""

# Freestyle Studio — model-aware Pony / SDXL generator environments.
# Both environments share CIVITAI_ORCHESTRATION_TOKEN; these are model AIRs, not credentials.
CIVITAI_STUDIO_PONY_V6_AIR="urn:air:sdxl:checkpoint:civitai:257749@290640"
CIVITAI_STUDIO_PONY_REALISM_AIR="urn:air:sdxl:checkpoint:civitai:372465@914390"
# Backward-compatible Pony V6 override; prefer CIVITAI_STUDIO_PONY_V6_AIR.
CIVITAI_STUDIO_PONY_DIFFUSER_AIR=""
CIVITAI_STUDIO_DEFAULT_NEGATIVE="low quality, bad anatomy, extra fingers, extra limbs, text, watermark"
CIVITAI_STUDIO_MAX_IMAGES="4"
CIVITAI_STUDIO_DEFAULT_STEPS="28"
CIVITAI_STUDIO_DEFAULT_CFG="5"

# Spellmark / Printful Cost Desk. Configure only in Vercel; never commit a real token.
# Create a private token for your own store in the Printful developer portal.
PRINTFUL_PRIVATE_TOKEN=""
# Optional for account-level tokens; omit for a single-store token.
PRINTFUL_STORE_ID=""
