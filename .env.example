# Runtime: use the pooled Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Prisma CLI/migrations: use the direct Neon connection string.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Canonical Vercel project: wizard-os-299p
# Legacy project wizard-os is retired and should not be reconnected to Git.

# Etsy / Warlock (values live in Vercel; never commit real secrets)
ETSY_API_KEYSTRING=""
ETSY_REDIRECT_URI="https://wizard-os-299p-jade.vercel.app/api/etsy/callback"
ETSY_SHARED_SECRET=""
ETSY_SESSION_SECRET=""

# The Museum AI responses + Chamber Chat.
# Free-tier default: poolside/laguna-s-2.1-free
# Override MUSEUM_AI_MODEL when paid AI Gateway credits are available (for example, openai/gpt-5.6-sol).
# AI_GATEWAY_API_KEY is an optional explicit fallback for local/non-OIDC environments.
AI_GATEWAY_API_KEY=""
MUSEUM_AI_MODEL="poolside/laguna-s-2.1-free"
